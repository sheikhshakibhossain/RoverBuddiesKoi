generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORG_OWNER
  TEAM_MANAGER
  SUBTEAM_MANAGER
  MEMBER
}

enum SkillStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DayOfWeek {
  Sun
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
}

model Organization {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  teams     Team[]
  semesters Semester[]
  users     User[]
  projects  Project[]
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subteams       Subteam[]
  users          User[]
  projects       Project[]
}

model Subteam {
  id          String   @id @default(uuid())
  teamId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userMembers UserSubteam[]
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  teamId         String?
  email          String       @unique
  passwordHash   String
  name           String
  initials       String
  role           Role         @default(MEMBER)
  requestedRole  Role?
  batch          String
  whatsapp       String
  avatarUrl      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team            Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  subteams        UserSubteam[]
  refreshTokens   RefreshToken[]
  routines        ClassRoutine[]
  skills          UserSkill[]   @relation("UserRequestedSkills")
  approvedSkills  UserSkill[]   @relation("ApprovedByUser")
  createdProjects Project[]     @relation("ProjectCreator")
  createdTasks    Task[]        @relation("TaskCreator")
  assignedTasks   Task[]        @relation("TaskAssignee")
}

model UserSubteam {
  userId    String
  subteamId String

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subteam   Subteam @relation(fields: [subteamId], references: [id], onDelete: Cascade)

  @@id([userId, subteamId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Semester {
  id              String       @id @default(uuid())
  organizationId  String
  name            String
  startDate       DateTime
  endDate         DateTime
  routineDeadline DateTime
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  routines        ClassRoutine[]
}

model ClassRoutine {
  id         String    @id @default(uuid())
  userId     String
  semesterId String
  day        DayOfWeek
  startTime  String    // HH:mm format e.g. "09:00"
  endTime    String    // HH:mm format e.g. "10:30"
  course     String
  room       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester   Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([userId, day])
}

model Skill {
  id        String      @id @default(uuid())
  name      String      @unique
  category  String      @default("General")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  users     UserSkill[]
}

model UserSkill {
  id               String      @id @default(uuid())
  userId           String
  skillId          String
  status           SkillStatus @default(PENDING)
  approvedByUserId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation("UserRequestedSkills", fields: [userId], references: [id], onDelete: Cascade)
  skill            Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)
  approvedBy       User?       @relation("ApprovedByUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, skillId])
}

model HeatmapSnapshot {
  id             String   @id @default(uuid())
  organizationId String
  computedAt     DateTime @default(now())
  // JSON: { days: [], hours: [], teamMatrix: {teamName: {day: {hour: {free,total,pct}}}}, subteamMatrix: {...} }
  matrix         Json

  @@index([organizationId, computedAt])
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  teamId         String?
  name           String
  description    String?
  color          String   @default("#6366f1")
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  tasks          Task[]
}

model Task {
  id             String   @id @default(uuid())
  projectId      String
  title          String
  description    String?
  status         String   @default("To Do")
  priority       String   @default("Medium")
  assigneeId     String?
  assigneeLabel  String?
  due            String?
  tags           String[]
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee       User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}
