# ==============================================================================
# RoverBuddiesKoi Environment Variables
# ==============================================================================

# Backend Server Settings
PORT=5000
NODE_ENV=development

# Database Connection (Neon PostgreSQL)
# Paste your connection string from Neon Console (e.g. postgresql://user:pass@ep-xyz.neon.tech/neondb?sslmode=require)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roverbuddies?schema=public"

# JWT Authentication Secrets
JWT_SECRET="roverbuddies_production_jwt_access_secret_2026_key"
JWT_REFRESH_SECRET="roverbuddies_production_jwt_refresh_secret_2026_key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Client Origin URL
CLIENT_URL="http://localhost:5173"

# Frontend Environment Variable
VITE_API_BASE_URL="http://localhost:5000"
